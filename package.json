{
  "name": "naver-competitor-ranking-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "collect:hourly": "node --env-file-if-exists=.env scripts/collect-hourly.mjs",
